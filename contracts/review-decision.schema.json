{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masayukihub/marketing-ai-workspace/contracts/review-decision.schema.json",
  "title": "Product Truth Human Review Decision Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "queue_id",
    "run_id",
    "project_id",
    "product_truth_proposal_ref",
    "generated_at",
    "gate",
    "review_scope",
    "protections",
    "status",
    "items"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "queue_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "product_truth_proposal_ref": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate": {
      "const": "PRODUCT_TRUTH_HUMAN_REVIEW_GATE"
    },
    "review_scope": {
      "const": "PRODUCT_TRUTH_PROPOSAL_ONLY"
    },
    "protections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_product_knowledge_write",
        "external_claim_approval",
        "external_publish"
      ],
      "properties": {
        "canonical_product_knowledge_write": {
          "const": false
        },
        "external_claim_approval": {
          "const": false
        },
        "external_publish": {
          "const": false
        }
      }
    },
    "status": {
      "enum": [
        "OPEN",
        "BLOCKED",
        "COMPLETE"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/review_item"
      }
    }
  },
  "$defs": {
    "review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "item_type",
        "item_id",
        "proposed_text",
        "proposal_status",
        "risk_level",
        "risk_reasons",
        "immediate_source_refs",
        "upstream_source_refs",
        "requested_action",
        "decision",
        "reviewer",
        "decided_at",
        "rationale",
        "decision_effect"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "item_type": {
          "enum": [
            "CLAIM",
            "FACT",
            "CONFLICT",
            "MISSING"
          ]
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "proposed_text": {
          "type": "string",
          "minLength": 1
        },
        "proposal_status": {
          "enum": [
            "PENDING_VERIFICATION",
            "CONDITIONAL",
            "CONFLICT",
            "PROHIBITED",
            "MISSING"
          ]
        },
        "risk_level": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "risk_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "immediate_source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "upstream_source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "requested_action": {
          "enum": [
            "VERIFY_SOURCE",
            "APPROVE_PROPOSAL",
            "REJECT_PROPOSAL",
            "REWRITE",
            "RESOLVE_CONFLICT"
          ]
        },
        "decision": {
          "enum": [
            "PENDING",
            "APPROVE_PROPOSAL",
            "REJECT_PROPOSAL",
            "REQUEST_CHANGES"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposal_only",
            "canonical_product_knowledge_write",
            "external_claim_approval"
          ],
          "properties": {
            "proposal_only": {
              "const": true
            },
            "canonical_product_knowledge_write": {
              "const": false
            },
            "external_claim_approval": {
              "const": false
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "PENDING"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "null"
              },
              "decided_at": {
                "type": "null"
              },
              "rationale": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
