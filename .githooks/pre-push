#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

pushes_main=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    pushes_main=1
  fi
done

if [[ "$pushes_main" -eq 1 && "${ALLOW_MAIN_PUSH:-0}" != "1" ]]; then
  echo "BLOCKED: do not push directly to main. Push a feature/fix branch and open a Pull Request."
  exit 1
fi

./scripts/verify.sh

echo "PASS: pre-push validation"
