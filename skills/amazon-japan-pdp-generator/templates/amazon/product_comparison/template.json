{
  "template_id": "P-COMPARISON",
  "family": "product_image",
  "name": "Comparison",
  "html": {
    "component": "product-comparison",
    "class": "tpl-p-comparison"
  },
  "css": {
    "grid_template_rows": "auto 1fr",
    "table_style": "uniform"
  },
  "svg": {
    "renderer": "renderProductComparison",
    "view_box": "0 0 2000 2000"
  },
  "grid": {
    "columns": 12,
    "rows": 12,
    "gutter_px": 32
  },
  "product_area": {
    "columns": "9/13",
    "rows": "1/5",
    "fit": "contain"
  },
  "text_area": {
    "columns": "1/9",
    "rows": "1/4",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 100,
    "mobile_percent": 7
  },
  "font_size": {
    "headline_px": 72,
    "subcopy_px": 32,
    "table_px": 25
  },
  "headline_length": {
    "preferred": 18,
    "max": 28
  },
  "sub_copy_length": {
    "preferred": 42,
    "max": 64
  },
  "desktop_rules": [
    "same-scale products",
    "source-backed cells",
    "unknown cells stay internal"
  ],
  "mobile_rules": [
    "show selection criteria before dense details",
    "table labels at least 24px equivalent"
  ],
  "historical_reference": [
    "REF-AMZ-THERMOMETER-PLUS"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
