{
  "template_id": "A-THREE-FEATURE-GRID",
  "family": "aplus",
  "name": "Three Feature Grid",
  "html": {
    "component": "aplus-grid",
    "class": "tpl-a-three-grid"
  },
  "css": {
    "grid_template_columns": "repeat(3,1fr)",
    "min_height_px": 760
  },
  "svg": {
    "renderer": "renderAplusThreeGrid",
    "view_box": "0 0 1464 760"
  },
  "grid": {
    "columns": 3,
    "rows": 1,
    "gutter_px": 28
  },
  "product_area": {
    "per_card": "top 46 percent",
    "fit": "contain"
  },
  "text_area": {
    "per_card": "bottom 54 percent",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 60,
    "mobile_percent": 7
  },
  "font_size": {
    "headline_px": 28,
    "subcopy_px": 17
  },
  "headline_length": {
    "preferred": 14,
    "max": 22
  },
  "sub_copy_length": {
    "preferred": 44,
    "max": 66
  },
  "desktop_rules": [
    "exactly two or three consistent cards",
    "equal image scale",
    "no feature collage"
  ],
  "mobile_rules": [
    "cards stack vertically",
    "preserve equal card rhythm"
  ],
  "historical_reference": [
    "REF-AMZ-PLUG-MINI",
    "REF-SB-K11"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
