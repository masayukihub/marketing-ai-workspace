{
  "template_id": "P-FEATURE-SPLIT",
  "family": "product_image",
  "name": "Feature Split",
  "html": {
    "component": "product-feature-split",
    "class": "tpl-p-feature-split"
  },
  "css": {
    "grid_template_columns": "6fr 6fr",
    "background": "#FFFFFF"
  },
  "svg": {
    "renderer": "renderProductFeatureSplit",
    "view_box": "0 0 2000 2000"
  },
  "grid": {
    "columns": 12,
    "rows": 12,
    "gutter_px": 40
  },
  "product_area": {
    "columns": "1/7",
    "rows": "3/12",
    "fit": "contain"
  },
  "text_area": {
    "columns": "7/13",
    "rows": "3/11",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 110,
    "mobile_percent": 8
  },
  "font_size": {
    "headline_px": 80,
    "subcopy_px": 35,
    "proof_px": 27
  },
  "headline_length": {
    "preferred": 16,
    "max": 27
  },
  "sub_copy_length": {
    "preferred": 48,
    "max": 74
  },
  "desktop_rules": [
    "one feature and one benefit",
    "balanced split",
    "official product remains dominant"
  ],
  "mobile_rules": [
    "text then product",
    "no split-screen text below readable size"
  ],
  "historical_reference": [
    "REF-AMZ-THERMOMETER-PLUS"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
