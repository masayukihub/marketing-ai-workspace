{
  "template_id": "A-50-50-FEATURE",
  "family": "aplus",
  "name": "50/50 Feature",
  "html": {
    "component": "aplus-split",
    "class": "tpl-a-50-50"
  },
  "css": {
    "grid_template_columns": "1fr 1fr",
    "min_height_px": 620
  },
  "svg": {
    "renderer": "renderAplus5050",
    "view_box": "0 0 1464 620"
  },
  "grid": {
    "columns": 12,
    "rows": 6,
    "gutter_px": 36
  },
  "product_area": {
    "columns": "7/13",
    "rows": "1/7",
    "fit": "contain"
  },
  "text_area": {
    "columns": "1/7",
    "rows": "1/7",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 54,
    "mobile_percent": 8
  },
  "font_size": {
    "headline_px": 44,
    "subcopy_px": 22
  },
  "headline_length": {
    "preferred": 20,
    "max": 30
  },
  "sub_copy_length": {
    "preferred": 76,
    "max": 115
  },
  "desktop_rules": [
    "mechanism to benefit",
    "one primary feature",
    "one optional secondary note"
  ],
  "mobile_rules": [
    "stack text then image",
    "secondary note below main copy"
  ],
  "historical_reference": [
    "REF-AMZ-THERMOMETER-PLUS"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
