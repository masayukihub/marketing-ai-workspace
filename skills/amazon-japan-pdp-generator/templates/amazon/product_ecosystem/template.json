{
  "template_id": "P-ECOSYSTEM",
  "family": "product_image",
  "name": "Ecosystem",
  "html": {
    "component": "product-ecosystem",
    "class": "tpl-p-ecosystem"
  },
  "css": {
    "layout": "verified-network",
    "background": "#F1F8F9"
  },
  "svg": {
    "renderer": "renderProductEcosystem",
    "view_box": "0 0 2000 2000"
  },
  "grid": {
    "columns": 12,
    "rows": 12,
    "gutter_px": 36
  },
  "product_area": {
    "columns": "4/10",
    "rows": "4/10",
    "fit": "contain"
  },
  "text_area": {
    "columns": "2/12",
    "rows": "1/4",
    "align": "center"
  },
  "safe_area": {
    "desktop_px": 110,
    "mobile_percent": 8
  },
  "font_size": {
    "headline_px": 76,
    "subcopy_px": 34,
    "label_px": 26
  },
  "headline_length": {
    "preferred": 17,
    "max": 27
  },
  "sub_copy_length": {
    "preferred": 46,
    "max": 70
  },
  "desktop_rules": [
    "only verified relationships",
    "programmatic labels and connectors",
    "no invented UI or logos"
  ],
  "mobile_rules": [
    "relationships become vertical list",
    "labels stay at least 24px equivalent"
  ],
  "historical_reference": [
    "REF-SB-K11"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
