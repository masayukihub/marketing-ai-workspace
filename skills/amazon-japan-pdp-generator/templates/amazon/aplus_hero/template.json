{
  "template_id": "A-HERO",
  "family": "aplus",
  "name": "Hero",
  "html": {
    "component": "aplus-hero",
    "class": "tpl-a-hero"
  },
  "css": {
    "grid_template_columns": "5fr 7fr",
    "min_height_px": 600
  },
  "svg": {
    "renderer": "renderAplusHero",
    "view_box": "0 0 1464 600"
  },
  "grid": {
    "columns": 12,
    "rows": 6,
    "gutter_px": 32
  },
  "product_area": {
    "columns": "7/13",
    "rows": "1/7",
    "fit": "contain"
  },
  "text_area": {
    "columns": "1/7",
    "rows": "2/6",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 54,
    "mobile_percent": 8
  },
  "font_size": {
    "headline_px": 50,
    "subcopy_px": 24
  },
  "headline_length": {
    "preferred": 20,
    "max": 32
  },
  "sub_copy_length": {
    "preferred": 64,
    "max": 96
  },
  "desktop_rules": [
    "use once at opening",
    "one category and value statement",
    "one visual center"
  ],
  "mobile_rules": [
    "text block before image",
    "headline maximum three lines"
  ],
  "historical_reference": [
    "REF-AMZ-PLUG-MINI",
    "REF-AMZ-THERMOMETER-PLUS"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
