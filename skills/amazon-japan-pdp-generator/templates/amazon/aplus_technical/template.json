{
  "template_id": "A-TECHNICAL",
  "family": "aplus",
  "name": "Technical",
  "html": {
    "component": "aplus-technical",
    "class": "tpl-a-technical"
  },
  "css": {
    "grid_template_columns": "7fr 5fr",
    "min_height_px": 620
  },
  "svg": {
    "renderer": "renderAplusTechnical",
    "view_box": "0 0 1464 620"
  },
  "grid": {
    "columns": 12,
    "rows": 6,
    "gutter_px": 32
  },
  "product_area": {
    "columns": "1/8",
    "rows": "1/7",
    "fit": "contain"
  },
  "text_area": {
    "columns": "8/13",
    "rows": "1/7",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 54,
    "mobile_percent": 8
  },
  "font_size": {
    "headline_px": 42,
    "subcopy_px": 21,
    "proof_px": 17
  },
  "headline_length": {
    "preferred": 20,
    "max": 28
  },
  "sub_copy_length": {
    "preferred": 72,
    "max": 110
  },
  "desktop_rules": [
    "maximum three proof cards",
    "conditions beside claim",
    "technical text stays in graphic layer"
  ],
  "mobile_rules": [
    "proof cards stack",
    "conditions cannot fall below readable size"
  ],
  "historical_reference": [
    "REF-AMZ-THERMOMETER-PLUS",
    "REF-SB-K11"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
