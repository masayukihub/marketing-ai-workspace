{
  "template_id": "A-LIFESTYLE",
  "family": "aplus",
  "name": "Lifestyle",
  "html": {
    "component": "aplus-lifestyle",
    "class": "tpl-a-lifestyle"
  },
  "css": {
    "layout": "full-bleed",
    "min_height_px": 680
  },
  "svg": {
    "renderer": "renderAplusLifestyle",
    "view_box": "0 0 1464 680"
  },
  "grid": {
    "columns": 12,
    "rows": 6,
    "gutter_px": 32
  },
  "product_area": {
    "columns": "7/13",
    "rows": "2/7",
    "fit": "contain"
  },
  "text_area": {
    "columns": "1/7",
    "rows": "2/6",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 60,
    "mobile_percent": 10
  },
  "font_size": {
    "headline_px": 46,
    "subcopy_px": 22
  },
  "headline_length": {
    "preferred": 20,
    "max": 30
  },
  "sub_copy_length": {
    "preferred": 68,
    "max": 96
  },
  "desktop_rules": [
    "one believable moment",
    "text on controlled overlay",
    "official product stays accurate"
  ],
  "mobile_rules": [
    "keep face and product outside crop edges",
    "overlay text remains high contrast"
  ],
  "historical_reference": [
    "REF-SB-K11",
    "REF-AMZ-PLUG-MINI"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
