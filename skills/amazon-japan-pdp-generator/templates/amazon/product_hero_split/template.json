{
  "template_id": "P-HERO-SPLIT",
  "family": "product_image",
  "name": "Hero Split",
  "html": {
    "component": "product-split",
    "class": "tpl-p-hero-split"
  },
  "css": {
    "grid_template_columns": "5fr 7fr",
    "background": "accent_soft"
  },
  "svg": {
    "renderer": "renderProductHeroSplit",
    "view_box": "0 0 2000 2000"
  },
  "grid": {
    "columns": 12,
    "rows": 12,
    "gutter_px": 40
  },
  "product_area": {
    "columns": "6/13",
    "rows": "2/12",
    "fit": "contain"
  },
  "text_area": {
    "columns": "1/6",
    "rows": "3/10",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 120,
    "mobile_percent": 9
  },
  "font_size": {
    "headline_px": 92,
    "subcopy_px": 38,
    "proof_px": 28
  },
  "headline_length": {
    "preferred": 15,
    "max": 24
  },
  "sub_copy_length": {
    "preferred": 44,
    "max": 70
  },
  "desktop_rules": [
    "one hero value",
    "product occupies at least 42 percent",
    "maximum three information levels"
  ],
  "mobile_rules": [
    "headline before product",
    "headline maximum three lines",
    "subcopy maximum four lines"
  ],
  "historical_reference": [
    "REF-AMZ-PLUG-MINI",
    "REF-SB-K11"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
