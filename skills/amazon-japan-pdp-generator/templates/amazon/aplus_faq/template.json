{
  "template_id": "A-FAQ",
  "family": "aplus",
  "name": "FAQ",
  "html": {
    "component": "aplus-faq",
    "class": "tpl-a-faq"
  },
  "css": {
    "layout": "stacked-checklist",
    "min_height_px": 700
  },
  "svg": {
    "renderer": "renderAplusFaq",
    "view_box": "0 0 1464 700"
  },
  "grid": {
    "columns": 12,
    "rows": 7,
    "gutter_px": 28
  },
  "product_area": {
    "columns": "9/13",
    "rows": "1/4",
    "fit": "contain"
  },
  "text_area": {
    "columns": "1/13",
    "rows": "1/8",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 54,
    "mobile_percent": 8
  },
  "font_size": {
    "headline_px": 42,
    "subcopy_px": 20,
    "item_px": 18
  },
  "headline_length": {
    "preferred": 22,
    "max": 32
  },
  "sub_copy_length": {
    "preferred": 60,
    "max": 90
  },
  "desktop_rules": [
    "up to three objections",
    "included and separate-purchase items stay explicit",
    "no vague guarantee"
  ],
  "mobile_rules": [
    "FAQ rows stack",
    "question and answer remain adjacent",
    "no tiny footnotes"
  ],
  "historical_reference": [
    "REF-AMZ-A-PLUS",
    "REF-SB-K11"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
