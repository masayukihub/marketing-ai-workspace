{
  "template_id": "A-COMPARISON",
  "family": "aplus",
  "name": "Comparison",
  "html": {
    "component": "aplus-comparison",
    "class": "tpl-a-comparison"
  },
  "css": {
    "layout": "comparison-table",
    "min_height_px": 760
  },
  "svg": {
    "renderer": "renderAplusComparison",
    "view_box": "0 0 1464 760"
  },
  "grid": {
    "columns": 12,
    "rows": 8,
    "gutter_px": 24
  },
  "product_area": {
    "columns": "9/13",
    "rows": "1/3",
    "fit": "contain"
  },
  "text_area": {
    "columns": "1/9",
    "rows": "1/3",
    "align": "left"
  },
  "safe_area": {
    "desktop_px": 54,
    "mobile_percent": 7
  },
  "font_size": {
    "headline_px": 42,
    "subcopy_px": 21,
    "table_px": 17
  },
  "headline_length": {
    "preferred": 22,
    "max": 32
  },
  "sub_copy_length": {
    "preferred": 54,
    "max": 84
  },
  "desktop_rules": [
    "source-backed current values",
    "uniform columns",
    "selection aid rather than superiority claim"
  ],
  "mobile_rules": [
    "priority rows first",
    "allow horizontal review only in internal page; Amazon output must stay readable"
  ],
  "historical_reference": [
    "REF-AMZ-THERMOMETER-PLUS"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
