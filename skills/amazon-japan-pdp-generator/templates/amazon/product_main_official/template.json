{
  "template_id": "P-MAIN-OFFICIAL",
  "family": "product_image",
  "name": "Official Main",
  "html": {
    "component": "product-main",
    "class": "tpl-p-main-official"
  },
  "css": {
    "layout": "place-items:center",
    "background": "#FFFFFF"
  },
  "svg": {
    "renderer": "renderProductMain",
    "view_box": "0 0 2000 2000"
  },
  "grid": {
    "columns": 12,
    "rows": 12,
    "gutter_px": 0
  },
  "product_area": {
    "x": 170,
    "y": 170,
    "width": 1660,
    "height": 1660,
    "fit": "contain"
  },
  "text_area": null,
  "safe_area": {
    "desktop_px": 140,
    "mobile_percent": 8
  },
  "font_size": {
    "headline_px": 0,
    "subcopy_px": 0
  },
  "headline_length": {
    "preferred": 0,
    "max": 0
  },
  "sub_copy_length": {
    "preferred": 0,
    "max": 0
  },
  "desktop_rules": [
    "pure white",
    "no marketing copy",
    "official product layer centered"
  ],
  "mobile_rules": [
    "same composition",
    "product remains recognizable in thumbnail"
  ],
  "historical_reference": [
    "REF-AMZ-A-PLUS"
  ],
  "library_version": "2026.08-v4",
  "source_policy": {
    "product_layer": "User-provided official product asset only for formal launch",
    "scene_layer": "Official or licensed scene, then AI background without product, then placeholder",
    "graphic_layer": "Programmatic HTML/CSS/SVG only",
    "prohibited_ai": [
      "SwitchBot product body",
      "logo",
      "Japanese text",
      "comparison table",
      "technical diagram text",
      "UI"
    ]
  }
}
